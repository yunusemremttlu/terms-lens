{
  "manifest_version": 3,
  "name": "Terms Lens — Sözleşme Risk Okuyucu",
  "version": "0.1.0",
  "description": "Kullanım koşulları, gizlilik ve abonelik maddelerini alıntı kanıtıyla Türkçe açıklar.",
  "permissions": ["storage", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Terms Lens",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/extension/content.js"],
      "run_at": "document_idle"
    }
  ]
}
